{
  "version": 2,
  "functions": {
    "api/image.js": { "maxDuration": 60 },
    "api/generate.js": { "maxDuration": 60 },
    "api/audio.js": { "maxDuration": 60 },
    "api/video-start.js": { "maxDuration": 60 },
    "api/trends.js": { "maxDuration": 60 },
    "api/unify.js": { "maxDuration": 60 },
    "api/unify-status.js": { "maxDuration": 30 },
    "api/music.js": { "maxDuration": 30 },
    "api/music-gen.js": { "maxDuration": 60 },
    "api/videos.js": { "maxDuration": 60 },
    "api/refs.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/app.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
